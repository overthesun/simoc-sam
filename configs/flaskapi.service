# This unit file is used to launch the Flask API for the lightweight frontend.
# Use `sam setup-flask` to enable, `sam teardown-flask` to disable.
# Use `systemctl start/stop/restart/status flaskapi` to control the service.
# Use `journalctl -u flaskapi.service -f` to see the script output.

[Unit]
Description=Flask API serving SQLite sensor data to the frontend
StartLimitIntervalSec=0
After=network.target sqlwriter.service
Wants=sqlwriter.service

[Service]
User=pi
WorkingDirectory=/home/pi/simoc-sam
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/simoc-sam/venv/bin/gunicorn \
    --workers 2 \
    --bind 127.0.0.1:8082 \
    --access-logfile - \
    "simoc_sam.api:create_app()"
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
